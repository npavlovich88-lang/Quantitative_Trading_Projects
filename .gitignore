# ---------------------------------------------------------------- market data
# Raw and derived market data never enters this repository. It is large, vendor
# licensed and not redistributable. Point QUANT_DATA_ROOT at it instead.
data/
Data/
*.csv
*.parquet
*.pq
*.feather
*.arrow
*.h5
*.hdf5
*.npy
*.npz
*.json.gz
*.zip
*.7z
*.gz
*.tar
# tick / level-2 archives, whatever they get named
*_T2/
*_ohlcv*
*_ofi*
*tick*
*_L2*
*depth*

# keep the small fixtures the tests need, and source files the data patterns catch
!tests/baseline.json
!research/hypotheses.jsonl
!scripts/*.py
!src/**/*.py
!tests/*.py

