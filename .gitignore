*.key
*.p12
*.pfx
*.keystore
*token*
*apikey*
*api_key*
.netrc
.htpasswd
id_rsa*
id_ed25519*
*.ovpn

# broker / platform artefacts
topstep*
tradovate*
rithmic*
ninjatrader*
*account_id*
*accounts.json*

# ---------------------------------------------------------------- run output
# Research output is regenerable and often large; the pre-registration ledger is
# the one artefact worth keeping under version control.
out/
!out/hypotheses.jsonl
!out/holdout_ledger.jsonl
*.log

