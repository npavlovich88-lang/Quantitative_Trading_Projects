//@version=6
// =============================================================================================
//  MOMENTUM STATE  --  MES / MNQ
// =============================================================================================
//  This measures how much the market is about to move. It does NOT measure which way.
//
//  WHY THAT SPLIT IS REAL AND NOT A DISCLAIMER
//
//  Hypothesis 9 tested momentum filters at an EMA cross across 5,490 cells with 300 grouped bar
//  permutations. It PASSED, at p = 0.0033, and then failed a confound check:
//
//      favourable excursion, adverse excursion and forward realised range all scaled by the
//      SAME factor (agreeing to a median spread of 0.060 across 20 cells on five series),
//      while the mean return moved -0.027 ATR -- the WRONG way.
//
//  A filter that makes winners and losers larger in equal proportion is a volatility filter.
//  So the effect is about MAGNITUDE, not direction.
//
//  BUT THE SIZE OF IT WAS CHECKED AGAIN FOR THIS INDICATOR, AND IT IS SMALLER THAN THAT RUN
//  SUGGESTED. Hypothesis 9 compared the top tercile against the BOTTOM tercile of a composite
//  at a cross, with RAW (not deseasonalised) inputs. This indicator flags the top ~16% against
//  everything else, deseasonalised, at every bar. Measured forward realised range, active
//  versus the rest:
//
//      horizon (bars)              3      6     12     26
//      MES raw displacement     1.23   1.22   1.16   1.09
//      MES deseasonalised       1.13   1.11   1.08   1.04
//      MNQ raw displacement     1.07   1.06   1.04   1.00
//      MNQ deseasonalised       1.01   1.01   1.01   0.99
//
//  Deseasonalising removes HALF the effect on MES and ALL of it on MNQ. Raw displacement picks
//  bars with a median hour of 11.2; deseasonalised picks 11.9. A plain momentum reading is
//  partly just telling you what time it is.
//
//  So: on MES this flags a real but modest expansion, about 1.1x over the next few bars. On MNQ
//  it flags essentially nothing. Shown honestly rather than dropped, because "unusual for this
//  time of day" is still a reading nothing else on the chart gives you.
//
//  WHAT IS DELIBERATELY NOT HERE
//
//  Rotation count and trend persistence. Both are genuinely independent of displacement
//  (r = 0.00 and 0.11) and both measured AT CHANCE -- p = 0.85 and 0.78 in hypothesis 7, again
//  in hypothesis 9. They are the two measures built specifically to capture "candles in the
//  opposite direction", and they carry nothing. Including them would be decoration.
//
//  Also absent: signed efficiency ratio and speed as separate lines. They correlate 0.85 to 0.98
//  with displacement -- the same variable wearing three names. One axis, once.
//
//  THE SECOND AXIS IS READ BACKWARDS
//
//  Relative volume is the ONLY conditioner measured to be independent of displacement
//  (r = -0.15) that also fired: 21.0% of its cells beat their own null at p = 0.0033. But only
//  31% were positive -- within a directional state, HIGH relative volume predicted a WORSE
//  outcome. That is absorption: heavy trade with no progress means someone is filling the other
//  side. It is plotted as a WARNING, not as confirmation, which is the opposite of how every
//  framework treats volume.
//
//  DESEASONALISED, BECAUSE RAW SPEED IS MOSTLY A CLOCK
//
//  RTH volume swings by a factor of tens between the quiet hour and the open. A raw speed or
//  volume reading mostly recovers the time of day. Both axes are z-scored against an expanding
//  mean for their OWN 15-minute slot of the session, so "unusual" means unusual for 11:15, not
//  unusual compared with the cash open.
// =============================================================================================

indicator("Momentum State", "MOM", overlay = false)

lookback  = input.int(20,   "Displacement lookback (bars)", minval = 5)
atrLen    = input.int(14,   "ATR length",                   minval = 2)
hiZ       = input.float(1.0,  "Active threshold (z)",  step = 0.25,
     tooltip = "Measured forward realised range above this: MES about 1.13x over 3 bars decaying to 1.04x over 26. MNQ about 1.01x, i.e. nothing.")
loZ       = input.float(-0.5, "Quiet threshold (z)",   step = 0.25)
minObs    = input.int(20,   "Min samples per time slot before a z-score is shown", minval = 5)
sigLen    = input.int(9,    "Signal line length", minval = 2)
showVol   = input.bool(true,  "Relative volume (absorption warning)")

// ------------------------------------------------------------------ raw magnitude
atrV  = ta.atr(atrLen)
netMv = close - close[lookback]
dispS = atrV > 0 ? netMv / atrV : 0.0        // signed, for the direction tint only
dispA = math.abs(dispS)                       // unsigned magnitude -- this is the measured axis

// ------------------------------------------------------------------ time-of-day baselines
// 96 fifteen-minute slots per day. Expanding mean and variance per slot, so every z-score uses
// only slots that have already happened -- causal by construction, no look-ahead.
var array<float> dSum = array.new<float>(96, 0.0)
var array<float> dSq  = array.new<float>(96, 0.0)
var array<float> dCnt = array.new<float>(96, 0.0)
var array<float> vSum = array.new<float>(96, 0.0)
var array<float> vSq  = array.new<float>(96, 0.0)
var array<float> vCnt = array.new<float>(96, 0.0)

slot = math.min(95, math.max(0, (hour * 60 + minute) / 15))

zOf(sumA, sqA, cntA, x) =>
    n = array.get(cntA, slot)
    float z = na
    if n >= minObs and not na(x)
        m  = array.get(sumA, slot) / n
        v  = array.get(sqA, slot) / n - m * m
        sd = math.sqrt(math.max(v, 0.0))
        z := sd > 0 ? (x - m) / sd : na
    z

dispZ = zOf(dSum, dSq, dCnt, dispA)
relV  = ta.sma(volume, 200) > 0 ? volume / ta.sma(volume, 200) : na
volZ  = zOf(vSum, vSq, vCnt, volume)

// Update the baselines AFTER reading them, so the current bar never contributes to its own z.
if not na(dispA) and barstate.isconfirmed
    array.set(dSum, slot, array.get(dSum, slot) + dispA)
    array.set(dSq,  slot, array.get(dSq,  slot) + dispA * dispA)
    array.set(dCnt, slot, array.get(dCnt, slot) + 1.0)
if not na(volume) and barstate.isconfirmed
    array.set(vSum, slot, array.get(vSum, slot) + volume)
    array.set(vSq,  slot, array.get(vSq,  slot) + volume * volume)
    array.set(vCnt, slot, array.get(vCnt, slot) + 1.0)

// ------------------------------------------------------------------ state
// MACD-style panel with ATR semantics: the LEVEL is the reading, not a crossover. Higher means
// the market is moving more than it normally does at this time of day; zero IS normal for this
// 15-minute slot, so the zero line is the reference rather than a signal.
mom = dispZ
sig = ta.ema(nz(mom), sigLen)

rising = not na(mom) and mom > sig
strong = not na(mom) and mom >= hiZ
weak   = not na(mom) and mom <= loZ

// Four states, read like a MACD histogram: bright = expanding, faded = fading.
histCol = na(mom)              ? color.new(color.gray, 80) :
          strong and rising    ? color.new(color.orange, 0)  :   // expanding hard
          strong               ? color.new(color.orange, 55) :   // strong but rolling over
          mom > 0 and rising   ? color.new(color.blue, 25)   :   // building
          mom > 0              ? color.new(color.blue, 65)   :   // above normal, fading
          weak                 ? color.new(color.gray, 55)   :   // dead
                                 color.new(color.gray, 30)

plot(mom, "Momentum", histCol, 3, plot.style_columns)
plot(mom, "Momentum line", color.new(color.white, 55), 1)
plot(sig, "Signal", color.new(color.yellow, 20), 2)

hline(0,   "normal for this time", color.new(color.gray, 40), hline.style_solid)
hline(hiZ, "active", color.new(color.orange, 60), hline.style_dashed)
hline(loZ, "quiet",  color.new(color.gray, 70),  hline.style_dashed)

// Absorption as a background tint rather than dots -- it is context, not an event to count.
absorb = showVol and not na(volZ) and volZ >= 1.0 and not na(mom) and mom < hiZ
bgcolor(absorb ? color.new(color.red, 88) : na, title = "absorption")
plot(showVol ? volZ : na, "Volume z", color.new(color.red, 70), 1, display = display.pane)

active = strong
quiet  = weak

// ------------------------------------------------------------------ readout
var table tb = table.new(position.top_right, 2, 7, border_width = 1)
if barstate.islast
    hdr = color.new(color.gray, 80)
    on  = color.new(color.orange, 70)
    off = color.new(color.gray, 85)
    warn= color.new(color.red, 70)

    state = na(dispZ) ? "warming up" : active ? "ACTIVE" : quiet ? "quiet" : "normal"
    // Measured for THIS construction, not imported from hypothesis 9. MES 1.13x at 3 bars
    // decaying to 1.04x at 26; MNQ 1.01x, which is nothing.
    expand = active ? "MES ~1.1x range / MNQ ~1.0x" : quiet ? "below normal" : "about normal"

    table.cell(tb, 0, 0, "MOMENTUM", bgcolor = hdr, text_size = size.small)
    table.cell(tb, 1, 0, state, bgcolor = active ? on : off, text_size = size.small)
    table.cell(tb, 0, 1, "magnitude z", text_size = size.small)
    table.cell(tb, 1, 1, na(dispZ) ? "--" : str.tostring(dispZ, "#.##"), text_size = size.small)
    table.cell(tb, 0, 2, "expect next", text_size = size.small)
    table.cell(tb, 1, 2, expand, text_size = size.small)
    table.cell(tb, 0, 3, "volume z", text_size = size.small)
    table.cell(tb, 1, 3, na(volZ) ? "--" : str.tostring(volZ, "#.##"),
         bgcolor = absorb ? warn : na, text_size = size.small)
    table.cell(tb, 0, 4, "absorption", text_size = size.small)
    table.cell(tb, 1, 4, absorb ? "YES -- volume, no progress" : "no",
         bgcolor = absorb ? warn : na, text_size = size.small)
    table.cell(tb, 0, 5, "direction", text_size = size.small)
    table.cell(tb, 1, 5, (dispS > 0 ? "up " : "down ") + str.tostring(dispS, "#.##") + " ATR",
         text_size = size.small)
    table.cell(tb, 0, 6, "", text_size = size.tiny)
    table.cell(tb, 1, 6, "direction NOT predictive; magnitude weak on MES, nil on MNQ",
         text_size = size.tiny, text_color = color.new(color.red, 20))
